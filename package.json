{
  "name": "trackows",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:systemd": "systemd-run --user --scope -p MemoryMax=4096M nuxt dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "clean": "rm -rf .output .wrangler .nuxt node_modules",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "auth:generate": "dotenv -e .env -- auth generate --config auth.config.ts --output server/db/auth.ts -y && eslint --fix server/db/auth.ts",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate"
  },
  "dependencies": {
    "@indoorequal/vue-maplibre-gl": "^9.0.1",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/ui": "^4.11.0",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@turf/turf": "^7.4.0",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "geojson": "^0.5.0",
    "h3": "^1.15.11",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.5.0",
    "nuxt": "^4.5.2",
    "nuxt-maplibre": "1.2.2",
    "pg": "^8.23.0",
    "trpc-nuxt": "^2.1.2",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.41",
    "vue-echarts": "^8.1.0",
    "vue-router": "^5.2.0",
    "wkx": "^0.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@iconify-json/lucide": "^1.2.125",
    "@iconify-json/simple-icons": "^1.2.93",
    "@opentelemetry/api": "^1.9.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "mcp-remote": "^0.1.49",
    "nuxt-echarts": "1.0.1",
    "tsx": "^4.23.12",
    "typescript": "^6",
    "vue-tsc": "^3.3.11"
  }
}