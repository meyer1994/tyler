{
  "name": "trackows",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:systemd": "systemd-run --user --scope -p MemoryMax=4096M nuxt dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "clean": "rm -rf .output .wrangler .nuxt node_modules",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "auth:generate": "dotenv -e .env -- better-auth generate --config auth.config.ts --output server/db/auth.ts -y && eslint --fix server/db/auth.ts",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate"
  },
  "dependencies": {
    "@indoorequal/vue-maplibre-gl": "^8.4.2",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/ui": "^4.6.0",
    "@trpc/client": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/components": "^14.2.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "better-auth": "^1.5.6",
    "drizzle-orm": "^0.45.2",
    "geojson": "^0.5.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.21.1",
    "nuxt": "^4.4.2",
    "nuxt-maplibre": "1.2.2",
    "pg": "^8.20.0",
    "trpc-nuxt": "^2.0.2",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "wkx": "^0.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@iconify-json/lucide": "^1.2.100",
    "@iconify-json/simple-icons": "^1.2.75",
    "@opentelemetry/api": "^1.9.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.1.0",
    "mcp-remote": "^0.1.38",
    "nuxt-echarts": "1.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vue-tsc": "^3.2.6"
  }
}