{
  "name": "trackows",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:systemd": "systemd-run --user --scope -p MemoryMax=4096M nuxt dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "clean": "rm -rf .output .wrangler .nuxt node_modules",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "auth:generate": "dotenv -e .env -- better-auth generate --config auth.config.ts --output server/db/auth.ts -y && eslint --fix server/db/auth.ts",
    "db:generate": "dotenv -e .env drizzle-kit generate",
    "db:migrate": "pnpm run cf:migrate",
    "cf:deploy": "wrangler --cwd .output deploy",
    "cf:types": "wrangler types shared/wrangler.d.ts && eslint --fix shared/wrangler.d.ts",
    "cf:migrate": "wrangler d1 migrations apply trackows",
    "cf:dump": "wrangler d1 export trackows --output .data/dump.sqlite",
    "cf:import": "wrangler d1 execute trackows --file .data/dump.sqlite",
    "cf:secrets": "wrangler secret bulk .env"
  },
  "dependencies": {
    "@iconify-json/simple-icons": "^1.2.75",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/ui": "^4.6.0",
    "@trpc/client": "^11.15.0",
    "@trpc/server": "^11.15.0",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/components": "^14.2.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "better-auth": "^1.5.6",
    "drizzle-orm": "^0.45.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.21.1",
    "mitt": "^3.0.1",
    "nuxt": "^4.4.2",
    "nuxt-maplibre": "1.2.2",
    "trpc-nuxt": "^2.0.2",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@iconify-json/lucide": "^1.2.98",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "mcp-remote": "^0.1.38",
    "nitro-cloudflare-dev": "^0.2.2",
    "nuxt-echarts": "1.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.77.0"
  }
}