{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "app: chrome",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/app/app"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "app: nuxt",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/node_modules/nuxt/bin/nuxt.mjs",
      "args": ["dev"],
      "envFile": "${workspaceFolder}/app/.env",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "app: fullstack",
      "configurations": [
        "app: nuxt",
        "app: chrome"
      ]
    }
  ]
}
